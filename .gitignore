# 构建产物(由 build.bat 生成, 不入库)
tank-battle-cpp/tank-battle.exe
tank-battle-cpp/unit_tests.exe
tank-battle-cpp/*.dll
tank-battle-cpp/app_icon.res.o
tank-battle-cpp/tools/voice_control.exe
tank-battle-cpp/L0*.exe

# 自动化验证的临时截图/日志
shot*.png
shot*.png.full.png
dbg*.png
dbg*.log
*.log

# 原始素材压缩包(与素材目录内容重复)
*.zip

# 子集化的源字体(可由 README 给出的地址重新下载)
tank-battle-cpp/NotoSansSC-Regular.otf

# macOS 解包残留
__MACOSX/
.DS_Store

# 本机工具配置
.zcodeignore

# Python
__pycache__/

# 临时验证脚本/截图(下划线前缀一刀切, 免得 git add -A 再把工具文件提进库)
_*
